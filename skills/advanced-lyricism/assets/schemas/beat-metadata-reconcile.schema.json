    "measured": {"type": "object"},
    "metadata_claims": {"type": "object"},
    "comparison": {"type": "object"},
    "issues": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "array", "items": {"type": "string"}}
  }
}
