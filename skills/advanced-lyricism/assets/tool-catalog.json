{
  "schema": "advanced-lyricism.tool-catalog.v1",
  "principle": "Call every tool that can assist the current task; representations feed detectors and generators; evaluation returns dimension-specific diagnostics and comparisons for audition.",
  "tools": [
    {
      "id": "midi_to_json",
      "class": "representation",
      "script": "scripts/midi_to_json.py",
      "when": "MIDI or symbolic beat data is supplied",
      "input": [
        ".mid",
        ".midi"
      ],
      "output": "advanced-lyricism.music-event-ir.v1",
      "deterministic": true,
      "primary_domain": "musical-representation",
      "primary_reference": "references/musical-representation.md",
      "primary_template": "assets/templates/musical-representation.md",
      "runtime": {
        "required_capabilities": [
          "midi_parse"
        ],
        "preferred_capabilities": [],
        "safe_claims": [
          "MIDI event/timing representation when parser is available"
        ],
        "fallback": "If blocked, use supplied beat metadata or existing timing."
      },
      "cli": {
        "first": "python scripts/midi_to_json.py <beat.mid> -o <music.json>",
        "full": "python scripts/midi_to_json.py <beat.mid> --include-messages -o <music-full.json>"
      }
    },
    {
      "id": "audio_to_json",
      "class": "representation",
      "script": "scripts/audio_to_json.py",
      "when": "Audio is supplied and beat/onset/energy analysis would change writing",
      "input": [
        "audio file"
      ],
      "output": "advanced-lyricism.audio-event-ir.v1",
      "deterministic": true,
      "primary_domain": "musical-representation",
      "primary_reference": "references/musical-representation.md",
      "primary_template": "assets/templates/musical-representation.md",
      "runtime": {
        "required_capabilities": [
          "audio_analysis"
        ],
        "preferred_capabilities": [],
        "safe_claims": [
          "estimated tempo/beats/onsets/energy only when audio backend is available"
        ],
        "fallback": "If blocked, preserve supplied BPM and section timing."
      },
      "cli": {
        "first": "python scripts/audio_to_json.py <beat.wav> -o <audio.json>"
      }
    },
    {
      "id": "phoneme_map",
      "class": "representation",
      "script": "scripts/phoneme_map.py",
      "when": "Pronunciation, stress, syllable structure or rhyme uncertainty matters",
      "input": [
        "text"
      ],
      "output": "advanced-lyricism.phoneme-map.v2",
      "deterministic": true,
      "primary_domain": "lexical-engineering",
      "primary_reference": "references/lexical-engineering.md",
      "primary_template": "assets/templates/lexical-engineering.md",
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [
          "pronunciation_dictionary"
        ],
        "safe_claims": [
          "tokenization and heuristic syllable counts always; phonemes/stress only for covered tokens"
        ],
        "partial_forbidden_claims": [
          "absence of rhyme",
          "stress-grid fit",
          "phonological similarity for uncovered words"
        ],
        "fallback": "Use heuristic syllable counts plus explicit pronunciation uncertainty."
      },
      "agent_io": {
        "summary_flag": "--summary",
        "prefer_summary_for_first_inspection": true,
        "prefer_file_output_for_full": true,
        "full_output_pattern": "python scripts/phoneme_map.py <args> -o <scratch.json>",
        "summary_pattern": "python scripts/phoneme_map.py <args> --summary"
      },
      "cli": {
        "first": "python scripts/phoneme_map.py -i <lyrics.txt> --summary",
        "full": "python scripts/phoneme_map.py -i <lyrics.txt> -o <phonemes.json>",
        "accent_override": "python scripts/phoneme_map.py -i <lyrics.txt> --pronunciation-json <arpabet.json> --summary"
      }
    },
    {
      "id": "delivery_notation",
      "class": "representation",
      "script": "scripts/delivery_notation.py",
      "when": "Bars contain breath/emphasis/ad-lib/pitch/tone notation",
      "input": [
        "text"
      ],
      "output": "advanced-lyricism.delivery-ir.v1",
      "deterministic": true,
      "primary_domain": "performance-delivery",
      "primary_reference": "references/performance-delivery.md",
      "primary_template": "assets/templates/performance-delivery.md",
      "secondary_domains": [
        "revision-evaluation",
        "voice-register"
      ],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": [
          "parse explicit delivery notation already present in text"
        ]
      },
      "cli": {
        "first": "python scripts/delivery_notation.py -i <annotated-lyrics.txt> -o <delivery.json>"
      }
    },
    {
      "id": "music_structure",
      "class": "detection",
      "script": "scripts/music_structure.py",
      "when": "Need bar density, boundary, repetition or drum-anchor cues from music IR",
      "input": [
        "music-event IR",
        "audio-event IR"
      ],
      "output": "advanced-lyricism.music-structure.v1",
      "deterministic": true,
      "primary_domain": "musical-representation",
      "primary_reference": "references/musical-representation.md",
      "primary_template": "assets/templates/musical-representation.md",
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": [
          "derive structure cues only from valid music-event/audio-event IR"
        ]
      },
      "cli": {
        "first": "python scripts/music_structure.py <music-or-audio.json> -o <structure.json>"
      }
    },
    {
      "id": "beat_affordance",
      "class": "detection",
      "script": "scripts/beat_affordance.py",
      "when": "Need candidate lyric stress/negative-space interactions with analysed music",
      "input": [
        "text",
        "music-structure IR"
      ],
      "output": "advanced-lyricism.beat-affordance.v1",
      "deterministic": true,
      "primary_domain": "musical-representation",
      "primary_reference": "references/musical-representation.md",
      "primary_template": "assets/templates/musical-representation.md",
      "secondary_domains": [
        "genre-beat-fit",
        "performance-delivery",
        "prosody-flow"
      ],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": [
          "candidate stress/space relationships from supplied structure IR"
        ]
      },
      "cli": {
        "first": "python scripts/beat_affordance.py <structure.json> -i <lyrics.txt> -o <affordances.json>"
      }
    },
    {
      "id": "prosody_map",
      "class": "detection",
      "script": "scripts/prosody_map.py",
      "when": "Stress/density/grid friction is the suspected problem",
      "input": [
        "text",
        "BPM"
      ],
      "output": "advanced-lyricism.prosody-map.v2",
      "deterministic": true,
      "primary_domain": "prosody-flow",
      "primary_reference": "references/prosody-flow.md",
      "primary_template": "assets/templates/prosody-flow.md",
      "secondary_domains": [
        "revision-evaluation",
        "rhyme-phonology"
      ],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [
          "pronunciation_dictionary"
        ],
        "safe_claims": [
          "syllable density always; lexical-stress/grid projections only at reported stress coverage"
        ],
        "partial_forbidden_claims": [
          "best stress-grid fit when stress coverage is unavailable"
        ],
        "fallback": "Use density-only output and mark stress projections unavailable."
      },
      "agent_io": {
        "summary_flag": "--summary",
        "prefer_summary_for_first_inspection": true,
        "prefer_file_output_for_full": true,
        "full_output_pattern": "python scripts/prosody_map.py <args> -o <scratch.json>",
        "summary_pattern": "python scripts/prosody_map.py <args> --summary"
      },
      "cli": {
        "first": "python scripts/prosody_map.py -i <lyrics.txt> --bpm <BPM> --summary",
        "full": "python scripts/prosody_map.py -i <lyrics.txt> --bpm <BPM> -o <prosody.json>"
      }
    },
    {
      "id": "technique_opportunity",
      "class": "detection",
      "script": "scripts/technique_opportunity.py",
      "when": "Need plausible enjambment, suspension, caesura, gear-change, scheme or callback opportunities",
      "input": [
        "text"
      ],
      "output": "advanced-lyricism.technique-opportunities.v1",
      "deterministic": true,
      "primary_domain": "prosody-flow",
      "primary_reference": "references/prosody-flow.md",
      "primary_template": "assets/templates/prosody-flow.md",
      "secondary_domains": [
        "concept-architecture"
      ],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": [
          "syntax/lineation heuristics as opportunities, not prescriptions"
        ]
      },
      "cli": {
        "first": "python scripts/technique_opportunity.py -i <lyrics.txt> -o <opportunities.json>"
      }
    },
    {
      "id": "articulation_audit",
      "class": "detection",
      "script": "scripts/articulation_audit.py",
      "when": "Lines stumble or consonant density may be physically awkward",
      "input": [
        "text",
        "BPM"
      ],
      "output": "advanced-lyricism.articulation-audit.v2",
      "deterministic": true,
      "primary_domain": "rhyme-phonology",
      "primary_reference": "references/rhyme-phonology.md",
      "primary_template": "assets/templates/rhyme-phonology.md",
      "secondary_domains": [
        "prosody-flow"
      ],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [
          "pronunciation_dictionary"
        ],
        "safe_claims": [
          "density proxy always; phoneme-transition issues only at reported pronunciation coverage"
        ],
        "partial_forbidden_claims": [
          "no articulation issues detected when phoneme data is unavailable"
        ],
        "fallback": "Use density-only observations and require rehearsal for articulation."
      },
      "agent_io": {
        "summary_flag": "--summary",
        "prefer_summary_for_first_inspection": true,
        "prefer_file_output_for_full": false,
        "full_output_pattern": "python scripts/articulation_audit.py <args> -o <scratch.json>",
        "summary_pattern": "python scripts/articulation_audit.py <args> --summary"
      },
      "cli": {
        "first": "python scripts/articulation_audit.py -i <lyrics.txt> --bpm <BPM> --summary",
        "full": "python scripts/articulation_audit.py -i <lyrics.txt> --bpm <BPM> -o <articulation.json>"
      }
    },
    {
      "id": "rhyme_grid",
      "class": "detection",
      "script": "scripts/rhyme_grid.py",
      "when": "Need opening/mid/end rhyme-position mapping",
      "input": [
        "text"
      ],
      "output": "advanced-lyricism.rhyme-grid.v2",
      "deterministic": true,
      "primary_domain": "rhyme-phonology",
      "primary_reference": "references/rhyme-phonology.md",
      "primary_template": "assets/templates/rhyme-phonology.md",
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [
          "pronunciation_dictionary"
        ],
        "safe_claims": [
          "opening/mid/ending token positions always; phonological links only where both anchors are covered"
        ],
        "partial_forbidden_claims": [
          "perfect/no rhyme claims for unknown tails",
          "absence of positional rhyme when links are not comparable"
        ],
        "fallback": "Return positions with null similarity for unknown pairs and leave rhyme families unknown until pronunciation is available."
      },
      "agent_io": {
        "summary_flag": "--summary",
        "prefer_summary_for_first_inspection": true,
        "prefer_file_output_for_full": true,
        "full_output_pattern": "python scripts/rhyme_grid.py <args> -o <scratch.json>",
        "summary_pattern": "python scripts/rhyme_grid.py <args> --summary"
      },
      "cli": {
        "first": "python scripts/rhyme_grid.py -i <lyrics.txt> --summary",
        "full": "python scripts/rhyme_grid.py -i <lyrics.txt> -o <rhyme-grid.json>"
      }
    },
    {
      "id": "lexical_cloud",
      "class": "detection",
      "script": "scripts/lexical_cloud.py",
      "when": "Need vocabulary concentration, motif frequency or revision delta",
      "input": [
        "text",
        "optional comparison text"
      ],
      "output": "advanced-lyricism.lexical-cloud.v1",
      "deterministic": true,
      "primary_domain": "lexical-engineering",
      "primary_reference": "references/lexical-engineering.md",
      "primary_template": "assets/templates/lexical-engineering.md",
      "secondary_domains": [
        "creative-operations",
        "hook-song-form"
      ],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "conditional_capabilities": {
          "png": "wordcloud_png",
          "stem": "porter_stemming"
        },
        "safe_claims": [
          "lexical frequency/collocation JSON without optional rendering/stemming"
        ],
        "fallback": "Install or enable the missing optional capability; continue the base lexical JSON route while PNG or stemming becomes available."
      },
      "cli": {
        "first": "python scripts/lexical_cloud.py -i <lyrics.txt> -o <lexical.json>",
        "compare": "python scripts/lexical_cloud.py -i <draft-a.txt> --compare <draft-b.txt> -o <lexical-delta.json>",
        "png": "python scripts/lexical_cloud.py -i <lyrics.txt> --png <cloud.png> -o <lexical.json>"
      }
    },
    {
      "id": "rhyme_suggester",
      "class": "generation",
      "script": "scripts/rhyme_suggester.py",
      "when": "Need phonetic/slant rhyme candidates without committing to meaning",
      "input": [
        "target word"
      ],
      "output": "advanced-lyricism.rhyme-suggestions.v3",
      "deterministic": true,
      "primary_domain": "lexical-engineering",
      "primary_reference": "references/lexical-engineering.md",
      "primary_template": "assets/templates/lexical-engineering.md",
      "secondary_domains": [
        "creative-operations",
        "rhetoric-impact"
      ],
      "runtime": {
        "required_capabilities": [
          "pronunciation_dictionary"
        ],
        "preferred_capabilities": [],
        "safe_claims": [
          "dictionary-backed candidate search with explicit accent limitation"
        ],
        "fallback": "If blocked, use manual/user-pronunciation ideation rather than lexical suffix guessing."
      },
      "cli": {
        "first": "python scripts/rhyme_suggester.py <target-word> -n 20 -o <rhymes.json>",
        "accent_override": "python scripts/rhyme_suggester.py <target-word> --pronunciation-json <arpabet.json> -n 20 -o <rhymes.json>"
      }
    },
    {
      "id": "word_rearranger",
      "class": "transform",
      "script": "scripts/word_rearranger.py",
      "when": "Strong words exist but syntax/emphasis/order may be weak",
      "input": [
        "text",
        "seed"
      ],
      "output": "advanced-lyricism.word-rearrangements.v1",
      "deterministic_with_seed": true,
      "primary_domain": "concept-architecture",
      "primary_reference": "references/concept-architecture.md",
      "primary_template": "assets/templates/concept-architecture.md",
      "secondary_domains": [
        "lexical-engineering",
        "narrative-scene"
      ],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": [
          "seeded clause/word-order transformations under explicit constraints"
        ]
      },
      "cli": {
        "first": "python scripts/word_rearranger.py -i <lines.txt> -n 8 --seed 17 -o <variants.json>"
      }
    },
    {
      "id": "idea_lab",
      "class": "generation_transform",
      "script": "scripts/idea_lab.py",
      "when": "Need structural grammar, mutation, collision, permutation or random-walk exploration",
      "input": [
        "concepts and/or text",
        "seed"
      ],
      "output": "advanced-lyricism.idea-lab.v2",
      "deterministic_with_seed": true,
      "primary_domain": "concept-architecture",
      "primary_reference": "references/concept-architecture.md",
      "primary_template": "assets/templates/concept-architecture.md",
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": [
          "seeded structural/semantic ideation; selection remains separate"
        ]
      },
      "cli": {
        "first": "python scripts/idea_lab.py --mode grammar --concepts '<a>,<b>,<c>' -n 8 --seed 17 -o <ideas.json>"
      }
    },
    {
      "id": "arc_generator",
      "class": "generation",
      "script": "scripts/arc_generator.py",
      "when": "Need a relative section curve for density/tension/exposure/etc.",
      "input": [
        "bars",
        "dimensions",
        "shape",
        "seed"
      ],
      "output": "advanced-lyricism.arc-plan.v1",
      "deterministic_with_seed": true,
      "primary_domain": "concept-architecture",
      "primary_reference": "references/concept-architecture.md",
      "primary_template": "assets/templates/concept-architecture.md",
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": [
          "seeded parameter curves; not dramatic truth"
        ]
      },
      "cli": {
        "first": "python scripts/arc_generator.py --bars 16 --shape arch --seed 17 -o <arc.json>"
      }
    },
    {
      "id": "cadence_lab",
      "class": "generation",
      "script": "scripts/cadence_lab.py",
      "when": "Need alternative slot geometries for a syllable budget",
      "input": [
        "syllable count",
        "family",
        "seed"
      ],
      "output": "advanced-lyricism.cadence-candidates.v1",
      "deterministic_with_seed": true,
      "primary_domain": "prosody-flow",
      "primary_reference": "references/prosody-flow.md",
      "primary_template": "assets/templates/prosody-flow.md",
      "secondary_domains": [
        "musical-representation"
      ],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": [
          "candidate slot geometries; not performed flow"
        ]
      },
      "cli": {
        "first": "python scripts/cadence_lab.py --syllables <N> --family auto -n 8 --seed 17 -o <cadences.json>"
      }
    },
    {
      "id": "craft_audit",
      "class": "evaluation",
      "script": "scripts/craft_audit.py",
      "when": "Need broad mechanical text-first audit",
      "input": [
        "text",
        "optional BPM"
      ],
      "output": "advanced-lyricism.craft-audit.v2",
      "deterministic": true,
      "primary_domain": "revision-evaluation",
      "primary_reference": "references/revision-evaluation.md",
      "primary_template": "assets/templates/revision-evaluation.md",
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [
          "pronunciation_dictionary"
        ],
        "safe_claims": [
          "line/word/density/repetition metrics always; phonological metrics only when coverage is reported"
        ],
        "partial_forbidden_claims": [
          "zero rhyme-family coverage as proof of no rhyme",
          "zero internal echoes when pronunciation data is unavailable"
        ],
        "fallback": "Return null/unavailable phonological metrics while keeping lexical/density observations."
      },
      "agent_io": {
        "prefer_summary_for_first_inspection": true,
        "summary_pattern": "python scripts/craft_audit.py <input> --format markdown",
        "prefer_file_output_for_full": false
      },
      "cli": {
        "first": "python scripts/craft_audit.py <lyrics.txt> --bpm <BPM> --format markdown",
        "full": "python scripts/craft_audit.py <lyrics.txt> --bpm <BPM> > <craft.json>"
      }
    },
    {
      "id": "workbench",
      "class": "evaluation_aggregate",
      "script": "scripts/workbench.py",
      "when": "A real draft exists and several diagnostics are relevant",
      "input": [
        "text",
        "optional music-structure IR"
      ],
      "output": "advanced-lyricism.workbench.v2",
      "deterministic": true,
      "primary_domain": "revision-evaluation",
      "primary_reference": "references/revision-evaluation.md",
      "primary_template": "assets/templates/revision-evaluation.md",
      "secondary_domains": [
        "creative-operations"
      ],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [
          "pronunciation_dictionary"
        ],
        "safe_claims": [
          "aggregate component outputs with per-component support status"
        ],
        "partial_forbidden_claims": [
          "cross-component diagnosis that treats unavailable phonology as zero"
        ],
        "fallback": "Aggregate every available component, leave unavailable measurements empty, and continue with close reading and rehearsal."
      },
      "agent_io": {
        "summary_flag": "--summary",
        "prefer_summary_for_first_inspection": true,
        "prefer_file_output_for_full": true,
        "full_output_pattern": "python scripts/workbench.py <args> -o <scratch.json>",
        "summary_pattern": "python scripts/workbench.py <args> --summary"
      },
      "cli": {
        "first": "python scripts/workbench.py -i <lyrics.txt> --bpm <BPM> --summary",
        "full": "python scripts/workbench.py -i <lyrics.txt> --bpm <BPM> -o <workbench.json>"
      }
    },
    {
      "id": "beat_profile_summary",
      "class": "representation",
      "script": "scripts/beat_profile_summary.py",
      "when": "Using bundled beat JSON profiles",
      "input": [
        "beat JSON"
      ],
      "output": "summary JSON",
      "deterministic": true,
      "primary_domain": "musical-representation",
      "primary_reference": "references/musical-representation.md",
      "primary_template": "assets/templates/musical-representation.md",
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": [
          "summary of bundled beat-profile JSON"
        ]
      },
      "cli": {
        "first": "python scripts/beat_profile_summary.py <assets/beat-profiles/profile.json> --markdown"
      }
    },
    {
      "id": "wav_energy_probe",
      "class": "representation",
      "script": "scripts/wav_energy_probe.py",
      "when": "A PCM WAV needs energy, coarse pulse or section-change mapping",
      "input": ["PCM WAV audio"],
      "output": "advanced-lyricism.wav-energy-profile.v1",
      "deterministic": true,
      "primary_domain": "musical-representation",
      "primary_reference": "references/musical-representation.md",
      "primary_template": "assets/templates/musical-representation.md",
      "secondary_domains": ["genre-beat-fit", "hook-song-form"],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": ["PCM WAV duration, relative frame energy, section changes and a coarse pulse candidate"],
        "partial_forbidden_claims": ["formal section names", "key or harmony", "confirmed BPM or half/double-time feel"]
      },
      "cli": {"first": "python scripts/wav_energy_probe.py <beat.wav> -o <wav-energy.json>"}
    },
    {
      "id": "beat_metadata_reconcile",
      "class": "detection",
      "script": "scripts/beat_metadata_reconcile.py",
      "when": "Beat metadata BPM/key claims need comparison with analysis output",
      "input": ["audio/WAV/MIDI/beat analysis JSON", "metadata text"],
      "output": "advanced-lyricism.beat-metadata-reconcile.v1",
      "deterministic": true,
      "primary_domain": "musical-representation",
      "primary_reference": "references/musical-representation.md",
      "primary_template": "assets/templates/musical-representation.md",
      "secondary_domains": ["genre-beat-fit"],
      "runtime": {
        "required_capabilities": [],
        "preferred_capabilities": [],
        "safe_claims": ["BPM/key claim extraction and same/half/double-time comparison against supplied analysis fields"]
      },
      "cli": {"first": "python scripts/beat_metadata_reconcile.py <analysis.json> --text \"142 BPM F# minor\" -o <metadata-check.json>"}
    },
    {
      "id": "semantic_field_map",
      "class": "detection",
      "script": "scripts/semantic_field_map.py",
      "when": "Lyrics need semantic-field distribution, progression or collision mapping",
      "input": ["text", "universal or uk-drill preset", "optional custom field JSON"],
      "output": "advanced-lyricism.semantic-field-map.v1",
      "deterministic": true,
