      "reference": "references/revision-evaluation.md",
      "template": "assets/templates/revision-evaluation.md",
      "purpose": "Diagnose every relevant weakness and opportunity, identify their interactions and priorities, apply a coordinated high-leverage revision set, and route findings to all owning domains.",
      "primary_tools": [
